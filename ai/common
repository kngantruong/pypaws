"""Thành phần dùng chung cho train.py, evaluate.py, build_train_subset.py.
 
Quy ước tên file ảnh PetFace:
  tên trong CSV : dog/022236/00.png
  tên phẳng     : dog_022236_00.png   (dùng khi giải nén ra một thư mục duy nhất)
  ID cá thể     : dog_022236
"""
import os
 
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import torch.nn.functional as F
import torchvision.transforms as T
from PIL import Image
from sklearn.metrics import roc_auc_score, roc_curve
 
IMG_SIZE = 224
MEAN, STD = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]
BACKBONE_DIM = 384   # DINOv2 ViT-S/14
EMB_DIM = 512
IMG_EXT = ('.png', '.jpg', '.jpeg')
 
 
# ---------------------------------------------------------------- tên file / ID
def flat(fn):
    """'dog/000123/00.png' -> 'dog_000123_00.png'"""
    return str(fn).replace('\\', '/').replace('/', '_')
 
 
def pid_of(fn):
    """'dog/000123/00.png' -> 'dog_000123'"""
    p = str(fn).replace('\\', '/').split('/')
    return f'{p[0]}_{p[1]}'
 
 
def build_image_index(base):
    """{tên file phẳng: đường dẫn đầy đủ} cho mọi ảnh trong `base`."""
    return {f: os.path.join(r, f)
            for r, _, fs in os.walk(base) for f in fs if f.lower().endswith(IMG_EXT)}
 
 
# ---------------------------------------------------------------- transform
NORM = T.Normalize(MEAN, STD)
 
 
def train_transform():
    return T.Compose([T.RandomResizedCrop(IMG_SIZE, scale=(0.7, 1.0)), T.RandomHorizontalFlip(),
                      T.ColorJitter(0.2, 0.2, 0.2), T.ToTensor(), NORM])
 
 
def eval_transform():
    return T.Compose([T.Resize((IMG_SIZE, IMG_SIZE)), T.ToTensor(), NORM])
 
 
# ---------------------------------------------------------------- mô hình
class Net(nn.Module):
    """DINOv2 ViT-S/14 + đầu embedding 512 chiều (Linear + BatchNorm1d), đầu ra đã L2-normalize."""
 
    def __init__(self, pretrained=True):
        super().__init__()
        self.bb = torch.hub.load('facebookresearch/dinov2', 'dinov2_vits14', pretrained=pretrained)
        self.emb = nn.Sequential(nn.Linear(BACKBONE_DIM, EMB_DIM), nn.BatchNorm1d(EMB_DIM))
 
    def forward(self, x, use_head=True):
        f = self.bb(x)
        return F.normalize(self.emb(f) if use_head else f, dim=1)
 
 
class ArcFace(nn.Module):
    def __init__(self, dim, n_cls, scale=30.0, margin=0.3):
        super().__init__()
        self.W = nn.Parameter(torch.randn(n_cls, dim) * 0.01)
        self.s, self.m = scale, margin
 
    def forward(self, emb, y):
        cos = F.linear(emb, F.normalize(self.W)).clamp(-1 + 1e-7, 1 - 1e-7)
        target = torch.cos(torch.acos(cos) + self.m)
        onehot = F.one_hot(y, cos.size(1)).bool()
        return F.cross_entropy(self.s * torch.where(onehot, target, cos), y)
 
 
def load_finetuned(ckpt_path, device='cuda'):
    """Nạp checkpoint fine-tune. Không cần tải lại trọng số pretrain vì checkpoint đã chứa backbone."""
    model = Net(pretrained=False).to(device)
    ck = torch.load(ckpt_path, map_location=device)
    model.load_state_dict(ck['model'] if 'model' in ck else ck)
    return model.eval()
 
 
# ---------------------------------------------------------------- embed + đánh giá
@torch.no_grad()
def embed_paths(model, paths, use_head=True, device='cuda', bs=128, tta=True):
    """Embedding L2-normalize cho danh sách ảnh. tta=True: cộng embedding ảnh gốc và ảnh lật ngang."""
    model.eval()
    tf, out = eval_transform(), []
    for i in range(0, len(paths), bs):
        x = torch.stack([tf(Image.open(p).convert('RGB')) for p in paths[i:i + bs]]).to(device)
        with torch.autocast('cuda', dtype=torch.float16, enabled=str(device).startswith('cuda')):
            e = model(x, use_head)
            if tta:
                e = e + model(torch.flip(x, dims=[3]), use_head)
        out.append(F.normalize(e.float(), dim=1).cpu())
    return torch.cat(out)
 
 
def load_verification(root, img_dir, animals=('dog', 'cat')):
    """Đọc verification.csv, chỉ giữ cặp có đủ cả 2 ảnh trên đĩa."""
    idx = build_image_index(img_dir)
    resolve = lambda fn: idx.get(flat(fn))
    parts = []
    for a in animals:
        d = pd.read_csv(f'{root}/{a}/verification.csv')
        d['fa'], d['fb'] = d['filename1'].map(resolve), d['filename2'].map(resolve)
        d['pa'], d['pb'] = d['filename1'].map(pid_of), d['filename2'].map(pid_of)
        d['animal'] = a
        parts.append(d.dropna(subset=['fa', 'fb']))
    return pd.concat(parts, ignore_index=True)
 
 
def pair_similarities(model, ve, use_head=True, device='cuda', tta=True):
    uniq = sorted(set(ve['fa']) | set(ve['fb']))
    emb = dict(zip(uniq, embed_paths(model, uniq, use_head, device, tta=tta)))
    return np.array([float(emb[a] @ emb[b]) for a, b in zip(ve['fa'], ve['fb'])])
 
 
def verification_metrics(sim, y):
    """AUC, Acc (ngưỡng tối ưu), EER, TPR@FPR=1%, điểm trung bình same/diff."""
    y = np.asarray(y).astype(int)
    fpr, tpr, thr = roc_curve(y, sim)
    accs = [((sim >= t).astype(int) == y).mean() for t in thr]
    k = int(np.argmax(accs))
    fnr = 1 - tpr
    e = int(np.argmin(np.abs(fnr - fpr)))
    return dict(AUC=float(roc_auc_score(y, sim)), Acc=float(accs[k]), T=float(thr[k]),
                EER=float((fpr[e] + fnr[e]) / 2), TPR_at_FPR1=float(np.interp(0.01, fpr, tpr)),
                same=float(sim[y == 1].mean()), diff=float(sim[y == 0].mean()),
                fpr=fpr, tpr=tpr)
 
