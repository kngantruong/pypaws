# Sao chép thành .env (hoặc gộp các biến này vào .env của backend). KHÔNG commit file .env.

# BẮT BUỘC: khóa API từ Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=

# Tuỳ chọn (đã có giá trị mặc định):
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # vùng Singapore
# QWEN_MODEL=qwen3-vl-plus
# QWEN_TIMEOUT_SECONDS=60
# QWEN_MAX_RETRIES=2
# QWEN_MAX_TOKENS=450
# QWEN_MAX_IMAGE_MB=10
# QWEN_MAX_IMAGE_PIXELS=40000000
# QWEN_IMAGE_MAX_SIDE=1024
# QWEN_DISABLE_THINKING=false     # đặt true nếu mô hình đang chạy chế độ "thinking" làm chậm hoặc cắt cụt kết quả
