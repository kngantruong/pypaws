# Sao chép thành .env (hoặc gộp các biến này vào .env của backend). KHÔNG commit file .env.

# ===== Cấu hình OpenRouter (đang dùng) =====
QWEN_API_KEY=                                   # khóa OpenRouter (cũng nhận tên OPENROUTER_API_KEY hoặc DASHSCOPE_API_KEY)
QWEN_BASE_URL=https://openrouter.ai/api/v1      # có thể bỏ trống, đây là mặc định
QWEN_MODEL=                                     # chạy scripts/list_free_vision_models.py để chọn mô hình free đọc được ảnh
QWEN_FALLBACK_MODELS=openrouter/free            # mô hình dự phòng, cách nhau bằng dấu phẩy (tối đa 2 đến 3 mô hình)

# ===== Hoặc Alibaba Model Studio trực tiếp (bỏ comment, thay cho khối trên) =====
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-vl-plus
# QWEN_DISABLE_THINKING=false                   # chỉ cho Alibaba: true nếu mô hình chạy chế độ "thinking" làm chậm hoặc cắt cụt kết quả

# ===== Tuỳ chọn chung (đã có giá trị mặc định) =====
# QWEN_TIMEOUT_SECONDS=60
# QWEN_MAX_RETRIES=2
# QWEN_MAX_TOKENS=450
# QWEN_MAX_IMAGE_MB=10
# QWEN_MAX_IMAGE_PIXELS=40000000
# QWEN_IMAGE_MAX_SIDE=1024
