APP_NAME=PyPaws Backend
APP_ENV=development

# Supabase project settings
SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Frontend Vite development server
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=backend/uploads

# Location / geocoding (MVP: OpenStreetMap Nominatim; no API key)
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=PyPaws/0.1 (your-contact@example.com)
GEOCODER_TIMEOUT_SECONDS=8

# DINOv2 PetFace checkpoint; keep the checkpoint outside Git if it is large/private.
DINOV2_CHECKPOINT=ai/dinov2_petface/dinov2_petface_ft.pt

# Business matching thresholds (cosine similarity; configurable MVP heuristics)
MATCH_IMAGE_MIN_SIMILARITY=0.60
MATCH_IMAGE_REVIEW_SIMILARITY=0.70
MATCH_IMAGE_HIGH_SIMILARITY=0.80
MATCH_DEFAULT_RADIUS_KM=5

# Optional AI description module via OpenRouter
# QWEN_API_KEY=
# QWEN_MODEL=
# QWEN_BASE_URL=https://openrouter.ai/api/v1

# IMPORTANT: never put a real API key or Supabase service_role/secret key in Git.
